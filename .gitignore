# --- Generated output, and organization data ------------------------------
# None of this belongs in the repository: it is either a build artifact of a
# run or a list of real people. Keeping it out is what makes the repo
# publishable while the working tree stays useful.

# Written by `ghstats-sync` from live org membership: real GitHub logins
/members.txt

# Left over from the removed HTML report pipeline. Nothing writes these now,
# but an existing working tree still has them and they hold per-person data.
reports/
/report.html

# Hand-maintained repository and inactivity lists
/repos.txt
/inactive
cache.tgz

# Hand-maintained repo -> SonarCloud project map, read by `ghstats-sonar`.
# Organization data, not code: it names one company's repositories and its
# Sonar project keys, and it is edited far more often than anything tracked.
/sonar-projects.txt

# virtualenvwrapper writes the env name to a file, which `.venv/` does not match
/.venv

# uv writes this next to pyproject.toml; the project pins nothing, so it is
# a local resolution rather than a shared lock.
uv.lock

# Playwright MCP scratch output -- page snapshots of the running explorer,
# which contain whatever real data the store held at the time.
.playwright-mcp/
